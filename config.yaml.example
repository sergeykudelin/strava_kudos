stravaSessionCookie: "your-session-cookie"
athleteId: "your-athlete-id"
ignoreAthletes:
  - "athlete-id-1"
  - "athlete-id-2"
  - "athlete-id-3"
kudoRules:
  minDistance:
    GroupActivity: 5
    Run: 5
    TrailRun: 5
    Ride: 20
    MountainBikeRide: 20
    GravelRide: 20
    VirtualRide: 20
    IndoorCycling: 20
    AlpineSki: 10
  minTime:
    Workout: 15
    Walk: 15
    Hike: 15
    Swim: 15
    WeightTraining: 15
  activityNames:
    - "race|marathon|competition"
    - "birthday.*run"
    - "charity"